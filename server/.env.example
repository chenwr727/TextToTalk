# LLM_* 通用配置。LLM_API_URL 必须填完整 endpoint 路径：
#   OpenAI/DeepSeek: https://api.deepseek.com/v1/chat/completions
#   GLM(智谱):       https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# LLM_ENABLE_THINKING=false

# ── TTS 引擎
# 引擎与音色由配置文件 server/tts.config.json 驱动（加模型/音色只改配置，不改代码）。
# 可用 TTT_TTS_CONFIG 覆盖配置文件路径；默认引擎在配置文件的 defaultEngine 字段指定。
#
# 目前支持的模型：
#   1) Edge 在线语音（edge）—— 免密钥，开箱即用，无需任何配置。
#   2) 阿里云百炼 CosyVoice（dashscope）—— 需配置下方 DASHSCOPE_* 变量。
#   3) 阿里云百炼 Qwen-Audio-TTS（qwen-audio）—— 需配置下方 DASHSCOPE_* 变量。
#   4) 火山引擎 Seed-TTS（seedtts）—— 需配置下方 SEED_TTS_* 变量。
#
# 说明：dashscope / qwen-audio 共用阿里云百炼的密钥与工作空间。
# 未配置 DASHSCOPE_* 时，这两个引擎会自动隐藏，仅保留 Edge。
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# DASHSCOPE_WORKSPACE_ID=your-workspace-id
# DASHSCOPE_REGION=cn-beijing
#
# 说明：Seed-TTS 走火山引擎豆包语音合成大模型 2.0（HTTP Chunked 单向流式）。
# 未配置 SEED_TTS_API_KEY 时该引擎自动隐藏。RESOURCE_ID 大模型音色用 seed-tts-2.0，复刻音色用 seed-icl-2.0。
# SEED_TTS_API_KEY=your-volcengine-api-key
# SEED_TTS_RESOURCE_ID=seed-tts-2.0

# ── 渲染加速
# RENDER_CONCURRENCY=8
# RENDER_MAX_TASKS=1
# RENDER_SCALE=0.75
# RENDER_GL=angle
# RENDER_HW_ACCEL=0