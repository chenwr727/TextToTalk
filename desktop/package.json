{
  "name": "texttotalk-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "TextToTalk 桌面版外壳（Electron）",
  "main": "dist/main.js",
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "stage": "node scripts/stage-server.mjs",
    "web": "npm --prefix ../web run build",
    "build": "npm run web && npm run icon && npm run ffmpeg && npm run stage && tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "verify": "node scripts/verify-pack.mjs",
    "dist:win": "npm run build && electron-builder --win && npm run verify",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "electron-winstaller": true
  }
}
